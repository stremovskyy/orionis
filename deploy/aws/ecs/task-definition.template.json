{
  "family": "orionis-auth",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "${ORIONIS_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${ORIONIS_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "orionis-auth",
      "image": "stremovskyy/orionis:0.3.2",
      "essential": true,
      "entryPoint": ["/bin/sh", "-c"],
      "command": [
        "printf '%s' \"$ORIONIS_CONFIG_JSON\" > /tmp/orionis.json && exec /usr/local/bin/orionis -config /tmp/orionis.json"
      ],
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "GIN_MODE",
          "value": "release"
        }
      ],
      "secrets": [
        {
          "name": "ORIONIS_CONFIG_JSON",
          "valueFrom": "${ORIONIS_CONFIG_SECRET_ARN}"
        },
        {
          "name": "ORIONIS_SIGNING_KEY_PEM",
          "valueFrom": "${ORIONIS_SIGNING_KEY_SECRET_ARN}"
        },
        {
          "name": "ORIONIS_SIGNING_KEY_PEM_OLD",
          "valueFrom": "${ORIONIS_OLD_SIGNING_KEY_SECRET_ARN}"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "${ORIONIS_LOG_GROUP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "orionis"
        }
      }
    }
  ]
}
